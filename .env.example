# Copy to .env and fill in. See docs/DEPLOYMENT.md for how to obtain each value
# and docs/SECURITY.md for how secrets are used.

# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of this deployment. Used to build QR / apply links.
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────
# Local dev: `docker compose up -d` then use the value below.
DATABASE_URL="postgresql://qrify:qrify_dev_password@localhost:5432/qrify?schema=public"

# ── Secrets (generate with: openssl rand -base64 32) ────────────────────
# HMAC key used to sign QR / apply-link tokens (src/lib/qr/token.ts).
QR_TOKEN_SECRET=
# AES-256-GCM key (32 raw bytes, base64-encoded) used to encrypt OAuth
# access/refresh tokens at rest (src/lib/crypto.ts).
ENCRYPTION_KEY=
# HMAC key used to salt/hash IPs for QRScan analytics (no raw IPs stored).
IP_HASH_SALT=

# ── AI (Anthropic Claude) ────────────────────────────────────────────────
# Required for JD parsing, profile extraction, resume generation, matching.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── OAuth: Google (login) ────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: GitHub (login + candidate profile sync) ───────────────────────
# https://github.com/settings/developers -> OAuth Apps
# Scopes requested: read:user, user:email, public_repo (read-only profile data)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email (transactional: magic links, notifications, employer-inbox mail) ─
# Provider: Resend (https://resend.com). Leave RESEND_API_KEY empty in dev —
# the console email adapter logs emails to stdout instead of sending them.
RESEND_API_KEY=
EMAIL_FROM="QRify <apply@qrify.app>"

# ── Object storage (resumes, generated PDFs) ─────────────────────────────
# STORAGE_DRIVER=local writes under ./storage-local (dev only, gitignored).
# STORAGE_DRIVER=s3 uses any S3-compatible provider (AWS S3, Cloudflare R2,
# Supabase Storage, Backblaze B2).
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
